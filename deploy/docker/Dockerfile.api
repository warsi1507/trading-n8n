FROM node:20-alpine AS builder

WORKDIR /build

# Copy root package files
COPY app/package.json app/package-lock.json ./

# Copy all package.json files for workspaces
COPY app/api/package.json ./api/
COPY app/packages/common/package.json ./packages/common/
COPY app/packages/db/package.json ./packages/db/
COPY app/packages/logger/package.json ./packages/logger/

# Install dependencies using workspaces
RUN npm ci

# Copy the rest of the relevant source code
COPY app/packages ./packages
COPY app/api ./api

# Build shared packages first (order matters!)
RUN cd packages/common && npm run build
RUN cd packages/logger && npm run build
RUN cd packages/db && npm run build

# Build API
RUN cd api && npm run build

# Production Stage
FROM node:20-alpine

WORKDIR /app

# Only copy production files
COPY --from=builder /build/package.json /build/package-lock.json ./
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/api/package.json ./api/
COPY --from=builder /build/api/dist ./api/dist

COPY --from=builder /build/packages/common/package.json ./packages/common/
COPY --from=builder /build/packages/common/dist ./packages/common/dist

COPY --from=builder /build/packages/db/package.json ./packages/db/
COPY --from=builder /build/packages/db/dist ./packages/db/dist

COPY --from=builder /build/packages/logger/package.json ./packages/logger/
COPY --from=builder /build/packages/logger/dist ./packages/logger/dist

EXPOSE 9000

# Start API
CMD ["node", "api/dist/index.js"]
