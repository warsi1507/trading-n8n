# -------------------------
# Core Server Configuration
# -------------------------
# API server URI for external requests
API_URI=http://localhost:3000

# Port number for the API server
PORT=3000

# -------------------------
# Database
# -------------------------
# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/trading-n8n

# -------------------------
# Authentication (Clerk)
# -------------------------
# Clerk keys used for authenticating users
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Webhook Secret (used to sync user creation/deletion securely)
CLERK_WEBHOOK_SECRET=whsec_...

# -------------------------
# Security & Vault
# -------------------------
# 32-byte (64 character hex) master key used for AES-256-GCM encryption of external API keys.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: If this key is lost, all saved user credentials in the vault will become unrecoverable!
ENCRYPTION_KEY=your_64_character_hex_key_here