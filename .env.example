# ==========================================
# FLOWTRADE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. API Configuration
PORT=9000
API_URI=http://localhost:9000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:9000

# 2. Database (MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# 3. Redis (Upstash / Local)
REDIS_URL="rediss://default:<password>@<your-upstash-url>:6379"

# 4. Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# 5. Security (Vault)
ENCRYPTION_KEY=9c898454d37578bc54e14a4cda695204345de7fe6604710550c41853d89f2f6f

# 6. Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
