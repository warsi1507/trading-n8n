# --- Application Settings ---
API_URI=http://localhost:9000
PORT=9000

# --- Database & Caching ---
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
REDIS_URL=redis://127.0.0.1:6379

# --- Authentication (Clerk) ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Webhooks ---
# Secret for verifying Clerk webhook signatures (user creation)
CLERK_WEBHOOK_SECRET=whsec_...

# --- Security ---
# 32-byte hex string for AES-256-GCM encryption of Vault API keys
ENCRYPTION_KEY=9c898454d37578bc54e14a4cda695204345de7fe6604710550c41853d89f2f6f

# --- Email Notifications ---
# If left empty, the system will use Ethereal Email (fake SMTP) and print links in the console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
